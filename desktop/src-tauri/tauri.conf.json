{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sanguosha Practice",
  "version": "0.1.0",
  "identifier": "org.sanguosha.practice",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "三国杀练习局", "width": 1050, "height": 720, "minWidth": 660, "minHeight": 500 }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "externalBin": ["binaries/practice-engine"]
  }
}
